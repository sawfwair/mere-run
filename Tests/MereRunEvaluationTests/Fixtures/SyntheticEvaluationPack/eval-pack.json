{
  "schema_version": 1,
  "id": "synthetic-color-check",
  "version": "1.0.0",
  "description": "Synthetic fixture demonstrating external evaluation-pack wiring.",
  "case_files": [
    "cases.jsonl"
  ],
  "prompt_sets": [
    {
      "id": "concise",
      "system_prompt_file": "prompts/concise.txt"
    }
  ],
  "arms": [
    {
      "id": "base-neutral",
      "model_slot": "base",
      "adapter_scale": 1
    },
    {
      "id": "base-prompted",
      "model_slot": "base",
      "adapter_scale": 1,
      "prompt_set": "concise"
    },
    {
      "id": "adapter-neutral",
      "model_slot": "base",
      "adapter_slot": "candidate",
      "adapter_scale": 1
    },
    {
      "id": "adapter-prompted",
      "model_slot": "base",
      "adapter_slot": "candidate",
      "adapter_scale": 1,
      "prompt_set": "concise"
    }
  ],
  "sampling_profiles": [
    {
      "id": "sampled-quality",
      "temperature": 0.7,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0,
      "show_thinking": false
    },
    {
      "id": "deterministic-compliance",
      "temperature": 0,
      "top_p": 1,
      "top_k": 1,
      "min_p": 0,
      "show_thinking": false
    }
  ],
  "scorer": {
    "kind": "assertions",
    "arguments": [],
    "timeout_seconds": 30
  },
  "gates": [
    {
      "id": "held-out-pass-rate",
      "aggregation": "pass-rate",
      "comparator": ">=",
      "threshold": 0.5,
      "required": true,
      "filter": {
        "splits": [
          "held-out"
        ]
      }
    },
    {
      "id": "no-hard-failures",
      "aggregation": "hard-failure-count",
      "comparator": "==",
      "threshold": 0,
      "required": true
    }
  ],
  "defaults": {
    "trials": 2,
    "max_tokens": 64,
    "context_size": 2048,
    "logprobs": "summary",
    "top_logprobs": 5
  },
  "adapter_requirements": {
    "require_training_manifest": false,
    "require_completed_training": false,
    "require_base_model_match": false
  }
}
